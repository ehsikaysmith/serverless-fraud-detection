<mxCell id="title" value="Serverless Fraud Detection Platform" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1900" height="36" as="geometry"/></mxCell>
<mxCell id="subtitle" value="A serverless, event-driven fraud detection platform that scores card transactions in near real-time using rule-based checks and an Isolation Forest ML model on Lambda. Transactions flow through an HTTP API to an SQS-decoupled scoring pipeline. Flagged transactions are stored in DynamoDB with AI-generated explanations from Amazon Bedrock, and high-risk alerts go via SNS. All raw and scored data ..." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="1900" height="52" as="geometry"/></mxCell>
